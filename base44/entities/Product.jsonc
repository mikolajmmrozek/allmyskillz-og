{
  "name": "Product",
  "type": "object",
  "properties": {
    "title_pl": {
      "type": "string",
      "title": "Title (PL)"
    },
    "title_en": {
      "type": "string",
      "title": "Title (EN)"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "description_pl": {
      "type": "string",
      "title": "Description (PL)",
      "format": "richtext"
    },
    "description_en": {
      "type": "string",
      "title": "Description (EN)",
      "format": "richtext"
    },
    "price": {
      "type": "number",
      "title": "Price"
    },
    "compare_price": {
      "type": "number",
      "title": "Compare-at Price"
    },
    "currency": {
      "type": "string",
      "title": "Currency",
      "default": "PLN"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Images",
      "format": "media-list"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name_pl": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "stock": {
            "type": "number"
          }
        }
      },
      "title": "Variants"
    },
    "stock": {
      "type": "number",
      "title": "Stock",
      "default": 0
    },
    "is_digital": {
      "type": "boolean",
      "title": "Digital Product",
      "default": false
    },
    "digital_file": {
      "type": "string",
      "title": "Digital Download File",
      "format": "media"
    },
    "shipping_required": {
      "type": "boolean",
      "title": "Shipping Required",
      "default": true
    },
    "weight": {
      "type": "number",
      "title": "Weight (kg)"
    },
    "category_id": {
      "type": "string",
      "title": "Category",
      "relation": "Category"
    },
    "seo_title_pl": {
      "type": "string",
      "title": "SEO Title (PL)"
    },
    "seo_title_en": {
      "type": "string",
      "title": "SEO Title (EN)"
    },
    "seo_description_pl": {
      "type": "string",
      "title": "SEO Description (PL)"
    },
    "seo_description_en": {
      "type": "string",
      "title": "SEO Description (EN)"
    },
    "featured": {
      "type": "boolean",
      "title": "Featured",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft",
      "title": "Status"
    }
  },
  "required": [
    "title_en",
    "slug",
    "price"
  ]
}