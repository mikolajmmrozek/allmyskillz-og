{
  "name": "SiteSetting",
  "type": "object",
  "properties": {
    "site_name_pl": {
      "type": "string",
      "title": "Site Name (Primary Language)"
    },
    "site_name_en": {
      "type": "string",
      "title": "Site Name (English)"
    },
    "primary_language": {
      "type": "string",
      "enum": [
        "pl",
        "en",
        "bg",
        "hr",
        "cs",
        "da",
        "nl",
        "et",
        "fi",
        "fr",
        "de",
        "el",
        "hu",
        "ga",
        "it",
        "lv",
        "lt",
        "mt",
        "pt",
        "ro",
        "sk",
        "sl",
        "es",
        "sv",
        "ar",
        "bn",
        "zh",
        "hi",
        "id",
        "ja",
        "ko",
        "ms",
        "fa",
        "pa",
        "ru",
        "sw",
        "ta",
        "th",
        "tr",
        "ur",
        "vi",
        "ha",
        "yo",
        "te"
      ],
      "default": "pl",
      "title": "Primary Language",
      "description": "The site's main language. Content is authored in this language (stored in the _pl fields) and auto-translated to English on save."
    },
    "enabled_languages": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "pl",
          "en",
          "bg",
          "hr",
          "cs",
          "da",
          "nl",
          "et",
          "fi",
          "fr",
          "de",
          "el",
          "hu",
          "ga",
          "it",
          "lv",
          "lt",
          "mt",
          "pt",
          "ro",
          "sk",
          "sl",
          "es",
          "sv",
          "ar",
          "bn",
          "zh",
          "hi",
          "id",
          "ja",
          "ko",
          "ms",
          "fa",
          "pa",
          "ru",
          "sw",
          "ta",
          "th",
          "tr",
          "ur",
          "vi",
          "ha",
          "yo",
          "te"
        ]
      },
      "title": "Enabled Languages",
      "description": "Languages available in the public language switcher. The primary language and English are always included.",
      "default": [
        "pl",
        "en"
      ]
    },
    "tagline_pl": {
      "type": "string",
      "title": "Tagline (Primary Language)"
    },
    "tagline_en": {
      "type": "string",
      "title": "Tagline (English)"
    },
    "logo_url": {
      "type": "string",
      "title": "Logo",
      "format": "media"
    },
    "favicon_url": {
      "type": "string",
      "title": "Favicon",
      "format": "media"
    },
    "accent_color": {
      "type": "string",
      "title": "Accent Color",
      "default": "#CBFF00"
    },
    "theme": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ],
      "default": "light",
      "title": "Site Theme"
    },
    "font_package": {
      "type": "string",
      "enum": [
        "editorial",
        "modern",
        "elegant",
        "technical"
      ],
      "default": "editorial",
      "title": "Font Package"
    },
    "default_seo_title_pl": {
      "type": "string",
      "title": "Default SEO Title (Primary Language)"
    },
    "default_seo_title_en": {
      "type": "string",
      "title": "Default SEO Title (English)"
    },
    "default_seo_description_pl": {
      "type": "string",
      "title": "Default SEO Description (Primary Language)"
    },
    "default_seo_description_en": {
      "type": "string",
      "title": "Default SEO Description (English)"
    },
    "default_seo_keywords": {
      "type": "string",
      "title": "Default SEO Keywords"
    },
    "google_site_verification": {
      "type": "string",
      "title": "Google Site Verification",
      "description": "Content of the <meta name=\"google-site-verification\"> tag from Google Search Console (meta-tag method)."
    },
    "email": {
      "type": "string",
      "title": "Contact Email"
    },
    "phone": {
      "type": "string",
      "title": "Contact Phone"
    },
    "address_pl": {
      "type": "string",
      "title": "Address (Primary Language)"
    },
    "address_en": {
      "type": "string",
      "title": "Address (English)"
    },
    "maps_embed_url": {
      "type": "string",
      "title": "Google Maps Embed URL"
    },
    "instagram": {
      "type": "string",
      "title": "Instagram"
    },
    "linkedin": {
      "type": "string",
      "title": "LinkedIn"
    },
    "youtube": {
      "type": "string",
      "title": "YouTube"
    },
    "facebook": {
      "type": "string",
      "title": "Facebook"
    },
    "tiktok": {
      "type": "string",
      "title": "TikTok"
    }
  },
  "required": []
}