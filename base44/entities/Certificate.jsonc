{
  "name": "Certificate",
  "type": "object",
  "properties": {
    "title_pl": {
      "type": "string",
      "title": "Title (PL)"
    },
    "title_en": {
      "type": "string",
      "title": "Title (EN)"
    },
    "issuer": {
      "type": "string",
      "title": "Issuer"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "image": {
      "type": "string",
      "title": "Certificate Image",
      "format": "media"
    },
    "attachment": {
      "type": "string",
      "title": "Attachment (PDF)",
      "format": "media"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "published",
      "title": "Status"
    }
  },
  "required": [
    "title_en"
  ]
}