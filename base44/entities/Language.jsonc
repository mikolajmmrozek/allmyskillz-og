{
  "name": "Language",
  "type": "object",
  "properties": {
    "name_pl": {
      "type": "string",
      "title": "Name (PL)"
    },
    "name_en": {
      "type": "string",
      "title": "Name (EN)"
    },
    "level_pl": {
      "type": "string",
      "title": "Level (PL)"
    },
    "level_en": {
      "type": "string",
      "title": "Level (EN)"
    },
    "proficiency": {
      "type": "number",
      "title": "Proficiency (0-100)",
      "minimum": 0,
      "maximum": 100,
      "default": 50
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "published",
      "title": "Status"
    }
  },
  "required": [
    "name_en"
  ]
}