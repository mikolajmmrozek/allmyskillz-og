{
  "name": "ContactMessage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "subject": {
      "type": "string",
      "title": "Subject"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "is_read": {
      "type": "boolean",
      "title": "Read",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "read",
        "archived"
      ],
      "default": "new",
      "title": "Status"
    }
  },
  "required": [
    "name",
    "email",
    "message"
  ]
}