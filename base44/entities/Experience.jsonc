{
  "name": "Experience",
  "type": "object",
  "properties": {
    "company_pl": {
      "type": "string",
      "title": "Company (PL)"
    },
    "company_en": {
      "type": "string",
      "title": "Company (EN)"
    },
    "position_pl": {
      "type": "string",
      "title": "Position (PL)"
    },
    "position_en": {
      "type": "string",
      "title": "Position (EN)"
    },
    "start_year": {
      "type": "number",
      "title": "Start Year"
    },
    "end_year": {
      "type": "number",
      "title": "End Year"
    },
    "description_pl": {
      "type": "string",
      "title": "Description (PL)",
      "format": "richtext"
    },
    "description_en": {
      "type": "string",
      "title": "Description (EN)",
      "format": "richtext"
    },
    "location_pl": {
      "type": "string",
      "title": "Location (PL)"
    },
    "location_en": {
      "type": "string",
      "title": "Location (EN)"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Gallery",
      "format": "media-list"
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Videos",
      "format": "media-list"
    },
    "project_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Related Projects",
      "relation": "Project"
    },
    "achievement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Achievements",
      "relation": "Achievement"
    },
    "award_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Awards",
      "relation": "Award"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft",
      "title": "Status"
    }
  },
  "required": [
    "company_en",
    "position_en"
  ]
}