{
  "name": "Education",
  "type": "object",
  "properties": {
    "school_pl": {
      "type": "string",
      "title": "School (PL)"
    },
    "school_en": {
      "type": "string",
      "title": "School (EN)"
    },
    "degree_pl": {
      "type": "string",
      "title": "Degree (PL)"
    },
    "degree_en": {
      "type": "string",
      "title": "Degree (EN)"
    },
    "start_year": {
      "type": "number",
      "title": "Start Year"
    },
    "end_year": {
      "type": "number",
      "title": "End Year"
    },
    "description_pl": {
      "type": "string",
      "title": "Description (PL)",
      "format": "richtext"
    },
    "description_en": {
      "type": "string",
      "title": "Description (EN)",
      "format": "richtext"
    },
    "location_pl": {
      "type": "string",
      "title": "Location (PL)"
    },
    "location_en": {
      "type": "string",
      "title": "Location (EN)"
    },
    "background_image": {
      "type": "string",
      "title": "Background Image",
      "format": "media"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Gallery",
      "format": "media-list"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Attachments",
      "format": "media-list"
    },
    "post_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Related News",
      "relation": "Post"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft",
      "title": "Status"
    }
  },
  "required": [
    "school_en",
    "degree_en"
  ]
}