{
  "name": "Offer",
  "type": "object",
  "properties": {
    "title_pl": {
      "type": "string",
      "title": "Title (PL)"
    },
    "title_en": {
      "type": "string",
      "title": "Title (EN)"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "description_pl": {
      "type": "string",
      "title": "Description (PL)",
      "format": "richtext"
    },
    "description_en": {
      "type": "string",
      "title": "Description (EN)",
      "format": "richtext"
    },
    "mission_pl": {
      "type": "string",
      "title": "Mission (PL)",
      "format": "richtext"
    },
    "mission_en": {
      "type": "string",
      "title": "Mission (EN)",
      "format": "richtext"
    },
    "learn_pl": {
      "type": "string",
      "title": "What Participants Learn (PL)",
      "format": "richtext"
    },
    "learn_en": {
      "type": "string",
      "title": "What Participants Learn (EN)",
      "format": "richtext"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Gallery",
      "format": "media-list"
    },
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_pl": {
            "type": "string"
          },
          "question_en": {
            "type": "string"
          },
          "answer_pl": {
            "type": "string"
          },
          "answer_en": {
            "type": "string"
          }
        }
      },
      "title": "FAQ"
    },
    "cta_text_pl": {
      "type": "string",
      "title": "CTA Text (PL)"
    },
    "cta_text_en": {
      "type": "string",
      "title": "CTA Text (EN)"
    },
    "price": {
      "type": "number",
      "title": "Price (optional)"
    },
    "currency": {
      "type": "string",
      "title": "Currency",
      "default": "PLN"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft",
      "title": "Status"
    }
  },
  "required": [
    "title_en",
    "slug"
  ]
}