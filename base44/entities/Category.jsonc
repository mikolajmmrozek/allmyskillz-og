{
  "name": "Category",
  "type": "object",
  "properties": {
    "name_pl": {
      "type": "string",
      "title": "Name (PL)"
    },
    "name_en": {
      "type": "string",
      "title": "Name (EN)"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "description_pl": {
      "type": "string",
      "title": "Description (PL)"
    },
    "description_en": {
      "type": "string",
      "title": "Description (EN)"
    },
    "color": {
      "type": "string",
      "title": "Accent Color"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "published",
      "title": "Status"
    }
  },
  "required": [
    "name_en",
    "slug"
  ]
}