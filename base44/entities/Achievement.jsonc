{
  "name": "Achievement",
  "type": "object",
  "properties": {
    "title_pl": {
      "type": "string",
      "title": "Title (PL)"
    },
    "title_en": {
      "type": "string",
      "title": "Title (EN)"
    },
    "description_pl": {
      "type": "string",
      "title": "Description (PL)",
      "format": "richtext"
    },
    "description_en": {
      "type": "string",
      "title": "Description (EN)",
      "format": "richtext"
    },
    "project_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Related Projects",
      "relation": "Project"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "metric": {
      "type": "string",
      "title": "Metric / Number (e.g. 1M+ reach)"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft",
      "title": "Status"
    }
  },
  "required": [
    "title_en"
  ]
}