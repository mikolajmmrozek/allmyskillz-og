{
  "name": "NavigationItem",
  "type": "object",
  "properties": {
    "label_pl": {
      "type": "string",
      "title": "Label (PL)"
    },
    "label_en": {
      "type": "string",
      "title": "Label (EN)"
    },
    "href": {
      "type": "string",
      "title": "Link / Path"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    },
    "open_in_new_tab": {
      "type": "boolean",
      "title": "Open in New Tab",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "archived"
      ],
      "default": "published",
      "title": "Status"
    }
  },
  "required": [
    "label_en",
    "href"
  ]
}