{
  "name": "Partner",
  "type": "object",
  "properties": {
    "name_pl": {
      "type": "string",
      "title": "Name (PL)"
    },
    "name_en": {
      "type": "string",
      "title": "Name (EN)"
    },
    "logo_url": {
      "type": "string",
      "title": "Logo",
      "format": "media"
    },
    "website": {
      "type": "string",
      "title": "Website"
    },
    "description_pl": {
      "type": "string",
      "title": "Description (PL)"
    },
    "description_en": {
      "type": "string",
      "title": "Description (EN)"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "published",
      "title": "Status"
    }
  },
  "required": [
    "name_en"
  ]
}